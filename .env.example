# Copy this file to .env and fill in your values. .env is never uploaded to GitHub.

# Part 2 + 3: OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
OPENAI_MODEL_CHEAP=gpt-6-mini

# Part 2: Hunter (email check) - free account at hunter.io
HUNTER_API_KEY=

# Part 3: Gmail for sending (use a Gmail App Password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
